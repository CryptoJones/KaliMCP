# Copy to .env and adjust as needed. All KaliMCP vars are prefixed KALIMCP_.
# Every var is OPTIONAL; the defaults shown are what KaliMCP uses when unset.

# Engagement (logical scope/namespace for audit records and session state).
# Falls back to the on-disk active-engagement file, then "_default".
# KALIMCP_ENGAGEMENT=_default

# Audit log. KaliMCP writes a structured audit record on every tool invocation,
# always to stderr and (when writable) to a file.
# Override the log file path (default: /var/log/kalimcp.log):
# KALIMCP_LOG_FILE=/var/log/kalimcp.log
# Disable file logging entirely (any non-empty value); stderr logging remains:
# KALIMCP_NO_LOG=1

# Max concurrent wrapped-tool subprocesses (default: 8). Positive integer only.
# KALIMCP_MAX_CONCURRENCY=8

# Cap on tool output returned to the model, in characters (default: 65536).
# Overflow is truncated with a marker. Positive integer only.
# KALIMCP_MODEL_OUTPUT_LIMIT=65536

# Auto-record active-tool invocations into the engagement report.
# Enabled only when set to exactly "1" (default: off).
# KALIMCP_AUTORECORD=1
